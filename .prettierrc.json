{
    "plugins": ["prettier-plugin-astro"],
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        },
        {
            "files": "*.jsonc",
            "options": {
                "trailingComma": "none"
            }
        }
    ]
}
