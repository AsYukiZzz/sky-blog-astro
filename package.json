{
    "name": "sky-blog-theme-astro",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "GPL-3.0",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "prepare": "node scripts/install-git-hooks.mjs",
        "hooks:install": "node scripts/install-git-hooks.mjs",
        "dev": "astro dev --host 127.0.0.1",
        "check": "astro check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test tests/*.test.ts",
        "test:browser": "playwright test",
        "build": "astro check && astro build && node scripts/prepare-build.mjs && pagefind --site dist && node scripts/verify-build.mjs",
        "preview": "astro preview --host 127.0.0.1"
    },
    "dependencies": {
        "@astrojs/mdx": "8.0.2",
        "@astrojs/rss": "4.0.19",
        "@astrojs/sitemap": "3.7.4",
        "@fontsource/noto-serif-sc": "^5.3.0",
        "@fontsource/titan-one": "^5.3.0",
        "astro": "7.3.5",
        "sakana-widget": "4.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "^24.0.0",
        "daisyui": "5.7.44",
        "pagefind": "1.5.2",
        "prettier": "3.9.9",
        "prettier-plugin-astro": "1.1.0",
        "tailwindcss": "4.3.3",
        "typescript": "^6.0.2"
    }
}
