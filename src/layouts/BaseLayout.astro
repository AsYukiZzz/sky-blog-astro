---
import { ClientRouter } from 'astro:transitions';
import { site, theme } from '../config';
import { initialThemeScript } from '../lib/theme-state';
import { resolveGlobalTheme } from '../lib/global-theme';
import SiteBackground from '../components/SiteBackground.astro';
import PageLoading from '../components/PageLoading.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import SearchDialog from '../components/SearchDialog.astro';
import '../styles/global.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
interface Props {
    title?: string;
    description?: string;
    image?: string;
    article?: { publishedAt: Date; updatedAt?: Date; author: string };
    noindex?: boolean;
    articleDiscovery?: boolean;
}
const {
    title,
    description = site.description,
    image = '/images/mist.svg',
    article,
    noindex = false,
    articleDiscovery = false,
} = Astro.props;
const pageTitle = title
    ? `${title} · ${site.title}`
    : site.subtitle
      ? `${site.title} · ${site.subtitle}`
      : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const absoluteImage = new URL(image, Astro.site ?? site.url).href;
const global = resolveGlobalTheme(theme.global);
const schema = {
    '@context': 'https://schema.org',
    '@type': article ? 'BlogPosting' : 'WebPage',
    headline: title ?? site.title,
    description,
    url: canonical,
    image: absoluteImage,
    ...(article
        ? {
              datePublished: article.publishedAt.toISOString(),
              dateModified: (
                  article.updatedAt ?? article.publishedAt
              ).toISOString(),
              author: { '@type': 'Person', name: article.author },
          }
        : {}),
};
---

<!doctype html>
<html
    lang={site.language}
    data-theme="light"
    data-color-scheme="light"
    transition:name="root"
    transition:animate="none"
    style={{
        '--sky-glass-blur': `${global.glass.blur}px`,
        '--sky-glass-saturation': global.glass.saturation,
        '--sky-glass-opacity-light': global.glass.opacity.light,
        '--sky-glass-opacity-dark': global.glass.opacity.dark,
    }}
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/png" href="/images/theme-icon.png" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={site.title}
            href="/feed.xml"
        />
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:site_name" content={site.title} />
        <meta property="og:title" content={title ?? site.title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={absoluteImage} />
        <meta name="twitter:card" content="summary_large_image" />
        {noindex && <meta name="robots" content="noindex, follow" />}
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
        />
        <script is:inline set:html={initialThemeScript()} />
        <ClientRouter />
    </head>
    <body class={`body-font-${global.font}`}>
        <SiteBackground wallpaper={global.wallpaper} />
        <PageLoading />
        <a class="skip-link" href="#main-content">
            跳到正文
        </a>
        <Nav />
        <main id="main-content">
            <slot />
        </main>
        <Footer />
        <Dock articleDiscovery={articleDiscovery} />
        <SearchDialog />
        <slot name="floating" />
        <dialog
            id="image-lightbox"
            class="glass-surface sky-dialog lightbox-dialog"
            aria-label="图片预览"
        >
            <button
                class="icon-button lightbox-close"
                data-close-dialog
                aria-label="关闭图片预览"
            >
                ✕
            </button>
            <img alt="" />
            <p></p>
        </dialog>
        <div
            class="glass-surface toast-status"
            role="status"
            aria-live="polite"
            hidden
        ></div>
        <script>
            import '../scripts/runtime';
        </script>
    </body>
</html>
