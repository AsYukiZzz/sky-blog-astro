---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleDirectory from '../components/ArticleDirectory.astro';
import ArticlePostsDialog from '../components/ArticlePostsDialog.astro';
import ArticleRecommendations from '../components/ArticleRecommendations.astro';
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import { theme } from '../config';
import { getAuthor } from '../lib/author';
import {
    COPYRIGHT_LABELS,
    DEFAULT_COPYRIGHT,
    copyrightNote,
    copyrightSummary,
} from '../lib/copyright';
import { routeFor } from '../lib/content-model';
import { formatDate, readingTime } from '../lib/format';
import { buildToc } from '../lib/toc';
import type { PublicColumn } from '../lib/columns-model';
import '../styles/article.css';
interface Props {
    entry: CollectionEntry<'posts' | 'pages' | 'moments'>;
    headings: { depth: number; slug: string; text: string }[];
    previous?: CollectionEntry<'posts'>;
    next?: CollectionEntry<'posts'>;
    column?: PublicColumn<CollectionEntry<'posts'>>;
}
const { entry, headings, previous, next, column } = Astro.props;
const author = getAuthor();
if (author.id !== entry.data.author)
    throw new Error(`${entry.id}: unknown author ${entry.data.author}`);
const categories = 'categories' in entry.data ? entry.data.categories : [];
const headerTags =
    'tags' in entry.data && entry.collection !== 'moments'
        ? entry.data.tags.slice(0, 4)
        : [];
const copyright = 'copyright' in entry.data ? entry.data.copyright : undefined;
const noteText = copyrightNote(copyright);
const summaryText = copyrightSummary(copyright);
const toc = buildToc(headings);
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.cover}
    articleDiscovery
    article={{
        publishedAt: entry.data.publishedAt,
        updatedAt: entry.data.updatedAt,
        author: author.name,
    }}
>
    <div class="article-page">
        <header class="site-container article-header">
            <div
                class:list={[
                    'article-heading',
                    {
                        'glass-card': theme.post.header.appearance === 'glass',
                    },
                ]}
            >
                <div class="article-heading-content">
                    {(categories.length > 0 || headerTags.length > 0) && (
                        <div class="article-taxonomy">
                            {categories.length > 0 && (
                                <nav
                                    class="article-categories"
                                    aria-label="文章分类"
                                >
                                    {categories.map((id) => (
                                        <a href={routeFor('categories', id)}>
                                            {id}
                                        </a>
                                    ))}
                                </nav>
                            )}
                            {headerTags.length > 0 && (
                                <nav class="article-tags" aria-label="文章标签">
                                    {headerTags.map((id) => (
                                        <a href={routeFor('tags', id)}>#{id}</a>
                                    ))}
                                </nav>
                            )}
                        </div>
                    )}
                    <h1 data-pagefind-meta="title">{entry.data.title}</h1>
                    {entry.data.description && (
                        <p class="article-description" data-pagefind-body>
                            {entry.data.description}
                        </p>
                    )}
                    <ul class="article-meta" aria-label="文章信息">
                        <li>
                            <a
                                class="article-author"
                                href={routeFor('authors', author.id)}
                                rel="author"
                            >
                                <img
                                    src={author.avatar}
                                    width="24"
                                    height="24"
                                    alt=""
                                />
                                <span>{author.name}</span>
                            </a>
                        </li>
                        <li>
                            <span class="sr-only">发布于</span>
                            <time
                                datetime={entry.data.publishedAt.toISOString()}
                            >
                                {formatDate(entry.data.publishedAt)}
                            </time>
                        </li>
                        {entry.data.updatedAt && (
                            <li>
                                更新于
                                <time
                                    datetime={entry.data.updatedAt.toISOString()}
                                >
                                    {formatDate(entry.data.updatedAt)}
                                </time>
                            </li>
                        )}
                        <li>约 {readingTime(entry.body)} 分钟</li>
                    </ul>
                </div>
                {entry.data.cover && (
                    <div class="article-cover-wrap">
                        <img
                            class="article-cover"
                            src={entry.data.cover}
                            width="640"
                            height="320"
                            alt=""
                            decoding="async"
                        />
                        <svg
                            class="article-cover-clip"
                            viewBox="0 -2 30 56"
                            aria-hidden="true"
                            focusable="false"
                        >
                            <defs>
                                <linearGradient
                                    id="article-cover-clip-metal"
                                    gradientUnits="userSpaceOnUse"
                                    x1="4"
                                    y1="0"
                                    x2="26"
                                    y2="0"
                                >
                                    <stop offset="0" stop-color="#76838c" />
                                    <stop offset="0.22" stop-color="#dbe3e8" />
                                    <stop offset="0.45" stop-color="#ffffff" />
                                    <stop offset="0.65" stop-color="#b7c4cc" />
                                    <stop offset="1" stop-color="#6c7882" />
                                </linearGradient>
                            </defs>
                            <path
                                d="M10 42V14a5 5 0 0 1 10 0v27a8 8 0 0 1-16 0V12a11 11 0 0 1 22 0v29"
                                fill="none"
                                stroke="url(#article-cover-clip-metal)"
                                stroke-width="3"
                                stroke-linecap="round"
                            />
                        </svg>
                    </div>
                )}
            </div>
        </header>
        <div class="site-container">
            <div class="article-grid">
                <div class="article-main">
                    {(toc.length > 0 || column) && (
                        <details class="glass-card mobile-toc">
                            <summary>
                                <span>
                                    <Icon name="list" size={18} />
                                    {column ? '阅读目录' : '文章目录'}
                                    <small>{headings.length} 个标题</small>
                                </span>
                                <Icon name="chevron" size={16} />
                            </summary>
                            <ArticleDirectory
                                toc={toc}
                                column={column}
                                currentSlug={entry.data.slug}
                                variant="mobile"
                            />
                        </details>
                    )}
                    <article class="article-entry" data-pagefind-body>
                        <div class="glass-card article-paper">
                            <div id="article-content">
                                <slot />
                            </div>
                        </div>
                        <footer
                            class="glass-card article-footer"
                            data-pagefind-ignore
                        >
                            {entry.collection === 'posts' && (
                                <section
                                    class="copyright-box"
                                    aria-label="版权信息"
                                >
                                    <div class="copyright-heading">
                                        <h2 class="copyright-heading-label">
                                            <Icon name="document" size={16} />
                                            版权信息
                                        </h2>
                                        <span class="copyright-type">
                                            {
                                                COPYRIGHT_LABELS[
                                                    copyright?.type ??
                                                        DEFAULT_COPYRIGHT.type
                                                ]
                                            }
                                        </span>
                                    </div>
                                    <dl class="copyright-meta">
                                        <div>
                                            <dt>作者</dt>
                                            <dd>
                                                <a
                                                    href={routeFor(
                                                        'authors',
                                                        author.id,
                                                    )}
                                                >
                                                    <img
                                                        src={author.avatar}
                                                        width="20"
                                                        height="20"
                                                        alt=""
                                                        loading="lazy"
                                                    />
                                                    {author.name}
                                                </a>
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>发布于</dt>
                                            <dd>
                                                <time
                                                    datetime={entry.data.publishedAt.toISOString()}
                                                >
                                                    {formatDate(
                                                        entry.data.publishedAt,
                                                    )}
                                                </time>
                                            </dd>
                                        </div>
                                    </dl>
                                    <p class="copyright-note">{noteText}</p>
                                    {copyright?.source && (
                                        <p class="copyright-source">
                                            来源：
                                            <a
                                                href={copyright.source}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                原始作品 ↗
                                            </a>
                                        </p>
                                    )}
                                </section>
                            )}
                            {entry.collection === 'moments' && (
                                <div
                                    class="copyright-compact"
                                    data-pagefind-ignore
                                >
                                    <Icon name="document" size={15} />
                                    <span>{summaryText}</span>
                                    {copyright?.source && (
                                        <a
                                            href={copyright.source}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            来源 ↗
                                        </a>
                                    )}
                                </div>
                            )}
                            <div class="article-footer-actions">
                                <span class="article-footer-caption">
                                    分享这篇文章
                                </span>
                                <div class="article-share">
                                    <button
                                        type="button"
                                        class="article-footer-button"
                                        data-copy-link
                                    >
                                        <Icon name="link" size={16} />
                                        复制链接
                                    </button>
                                    <button
                                        type="button"
                                        class="article-footer-button"
                                        data-share
                                    >
                                        <Icon name="share" size={16} />
                                        分享文章
                                    </button>
                                </div>
                            </div>
                        </footer>
                    </article>
                    <nav
                        class="glass-card post-neighbors"
                        aria-label="相邻文章"
                        data-pagefind-ignore
                    >
                        {previous ? (
                            <a
                                class="post-neighbor post-neighbor-previous"
                                href={routeFor('posts', previous.data.slug)}
                            >
                                <span class="post-neighbor-label">
                                    <Icon name="arrow" size={16} />
                                    上一篇
                                </span>
                                <span class="post-neighbor-title">
                                    {previous.data.title}
                                </span>
                            </a>
                        ) : (
                            <button
                                type="button"
                                class="post-neighbor post-neighbor-previous"
                                disabled
                            >
                                <span class="post-neighbor-label">
                                    <Icon name="arrow" size={16} />
                                    上一篇
                                </span>
                                <span class="post-neighbor-title">
                                    没有更早的文章
                                </span>
                            </button>
                        )}
                        {next ? (
                            <a
                                class="post-neighbor post-neighbor-next"
                                href={routeFor('posts', next.data.slug)}
                            >
                                <span class="post-neighbor-label">
                                    下一篇
                                    <Icon name="arrow" size={16} />
                                </span>
                                <span class="post-neighbor-title">
                                    {next.data.title}
                                </span>
                            </a>
                        ) : (
                            <button
                                type="button"
                                class="post-neighbor post-neighbor-next"
                                disabled
                            >
                                <span class="post-neighbor-label">
                                    下一篇
                                    <Icon name="arrow" size={16} />
                                </span>
                                <span class="post-neighbor-title">
                                    没有更新的文章
                                </span>
                            </button>
                        )}
                    </nav>
                    <ArticleRecommendations
                        currentSlug={
                            entry.collection === 'posts'
                                ? entry.data.slug
                                : undefined
                        }
                    />
                    <Comments />
                </div>
                <aside class="article-side" data-pagefind-ignore>
                    <section class="glass-card toc-card" aria-label="阅读导航">
                        <ArticleDirectory
                            toc={toc}
                            column={column}
                            currentSlug={entry.data.slug}
                            variant="sidebar"
                        />
                        <div
                            class="article-directory-footer toc-progress-row"
                            data-directory-progress
                        >
                            <span class="toc-progress-label">阅读进度</span>
                            <div
                                class="reading-progress"
                                role="progressbar"
                                aria-label="文章阅读进度"
                                aria-valuemin="0"
                                aria-valuemax="100"
                                aria-valuenow="0"
                                data-reading-meter
                            >
                                <span data-reading-progress />
                            </div>
                            <small
                                class="toc-progress-value"
                                data-reading-percent
                                aria-hidden="true"
                            >
                                0%
                            </small>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </div>
    {(toc.length > 0 || column) && (
        <dialog
            id="article-toc-dialog"
            class="glass-surface sky-dialog toc-dialog"
            aria-labelledby="toc-dialog-heading"
            data-pagefind-ignore
        >
            <div class="dialog-heading">
                <div>
                    <p class="toc-dialog-article">{entry.data.title}</p>
                    <h2 id="toc-dialog-heading">
                        {column ? '阅读目录' : '文章目录'}
                    </h2>
                </div>
                <button
                    type="button"
                    class="icon-button"
                    data-close-dialog
                    aria-label="关闭文章目录"
                    autofocus
                >
                    <Icon name="close" size={22} />
                </button>
            </div>
            <div class="toc-dialog-content">
                <ArticleDirectory
                    toc={toc}
                    column={column}
                    currentSlug={entry.data.slug}
                    variant="dialog"
                />
            </div>
            <div class="toc-dialog-footer">
                <span data-directory-progress>
                    阅读进度 <span data-reading-percent>0%</span>
                </span>
                <kbd>Esc</kbd>
                <span>关闭目录</span>
            </div>
        </dialog>
    )}
    <ArticlePostsDialog
        currentSlug={entry.collection === 'posts' ? entry.data.slug : undefined}
    />
</BaseLayout>
