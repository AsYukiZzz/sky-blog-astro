---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleDirectory from '../components/ArticleDirectory.astro';
import ArticlePostsDialog from '../components/ArticlePostsDialog.astro';
import ArticleRecommendations from '../components/ArticleRecommendations.astro';
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import { getAuthor } from '../lib/author';
import {
    COPYRIGHT_LABELS,
    DEFAULT_COPYRIGHT,
    copyrightNote,
    copyrightSummary,
} from '../lib/copyright';
import { routeFor } from '../lib/content-model';
import { formatDate, readingTime } from '../lib/format';
import { buildToc } from '../lib/toc';
import type { PublicColumn } from '../lib/columns-model';
import '../styles/article.css';
interface Props {
    entry: CollectionEntry<'posts' | 'pages' | 'moments'>;
    headings: { depth: number; slug: string; text: string }[];
    previous?: CollectionEntry<'posts'>;
    next?: CollectionEntry<'posts'>;
    column?: PublicColumn<CollectionEntry<'posts'>>;
}
const { entry, headings, previous, next, column } = Astro.props;
const author = getAuthor();
if (author.id !== entry.data.author)
    throw new Error(`${entry.id}: unknown author ${entry.data.author}`);
const categories = 'categories' in entry.data ? entry.data.categories : [];
const tags = 'tags' in entry.data ? entry.data.tags : [];
const copyright = 'copyright' in entry.data ? entry.data.copyright : undefined;
const noteText = copyrightNote(copyright);
const summaryText = copyrightSummary(copyright);
const toc = buildToc(headings);
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.cover}
    articleDiscovery
    article={{
        publishedAt: entry.data.publishedAt,
        updatedAt: entry.data.updatedAt,
        author: author.name,
    }}
>
    <div class="article-page">
        <header class="article-banner">
            {entry.data.cover && (
                <img
                    class="article-banner-image"
                    src={entry.data.cover}
                    width="1440"
                    height="600"
                    alt=""
                />
            )}
            <div class="article-hero site-container">
                <div class="article-heading">
                    <div class="article-breadcrumb">
                        {categories.map((id) => (
                            <a href={routeFor('categories', id)}>{id}</a>
                        ))}
                        {entry.collection !== 'moments' &&
                            tags.slice(0, 4).map((id) => (
                                <a
                                    class="article-tag"
                                    href={routeFor('tags', id)}
                                >
                                    #{id}
                                </a>
                            ))}
                    </div>
                    <h1 data-pagefind-meta="title">{entry.data.title}</h1>
                    <div class="article-meta">
                        <a href={routeFor('authors', author.id)}>
                            <img
                                src={author.avatar}
                                width="24"
                                height="24"
                                alt=""
                            />
                            {author.name}
                        </a>
                        <span>
                            <Icon name="calendar" size={16} />
                            <time
                                datetime={entry.data.publishedAt.toISOString()}
                            >
                                {formatDate(entry.data.publishedAt)}
                            </time>
                        </span>
                        <span>
                            <Icon name="clock" size={16} />
                            {readingTime(entry.body)} 分钟
                        </span>
                        {entry.data.updatedAt && (
                            <span>
                                更新于 {formatDate(entry.data.updatedAt)}
                            </span>
                        )}
                    </div>
                </div>
            </div>
        </header>
        <div class="site-container">
            <div class="article-grid">
                <div class="article-main">
                    {(toc.length > 0 || column) && (
                        <details class="mobile-toc">
                            <summary>
                                <span>
                                    <Icon name="list" size={18} />
                                    {column ? '阅读目录' : '文章目录'}
                                    <small>{headings.length} 个标题</small>
                                </span>
                                <Icon name="chevron" size={16} />
                            </summary>
                            <ArticleDirectory
                                toc={toc}
                                column={column}
                                currentSlug={entry.data.slug}
                                variant="mobile"
                            />
                        </details>
                    )}
                    <article class="article-paper" data-pagefind-body>
                        {entry.data.description && (
                            <div class="article-excerpt">
                                {entry.data.description}
                            </div>
                        )}
                        <div id="article-content">
                            <slot />
                        </div>
                        <footer class="article-footer" data-pagefind-ignore>
                            {entry.collection === 'posts' && (
                                <section
                                    class="copyright-box"
                                    aria-label="版权信息"
                                >
                                    <div class="copyright-heading">
                                        <h2 class="copyright-heading-label">
                                            <Icon name="document" size={16} />
                                            版权信息
                                        </h2>
                                        <span class="copyright-type">
                                            {
                                                COPYRIGHT_LABELS[
                                                    copyright?.type ??
                                                        DEFAULT_COPYRIGHT.type
                                                ]
                                            }
                                        </span>
                                    </div>
                                    <dl class="copyright-meta">
                                        <div>
                                            <dt>作者</dt>
                                            <dd>
                                                <a
                                                    href={routeFor(
                                                        'authors',
                                                        author.id,
                                                    )}
                                                >
                                                    <img
                                                        src={author.avatar}
                                                        width="20"
                                                        height="20"
                                                        alt=""
                                                        loading="lazy"
                                                    />
                                                    {author.name}
                                                </a>
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>发布于</dt>
                                            <dd>
                                                <time
                                                    datetime={entry.data.publishedAt.toISOString()}
                                                >
                                                    {formatDate(
                                                        entry.data.publishedAt,
                                                    )}
                                                </time>
                                            </dd>
                                        </div>
                                    </dl>
                                    <p class="copyright-note">{noteText}</p>
                                    {copyright?.source && (
                                        <p class="copyright-source">
                                            来源：
                                            <a
                                                href={copyright.source}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                原始作品 ↗
                                            </a>
                                        </p>
                                    )}
                                </section>
                            )}
                            {entry.collection === 'moments' && (
                                <div
                                    class="copyright-compact"
                                    data-pagefind-ignore
                                >
                                    <Icon name="document" size={15} />
                                    <span>{summaryText}</span>
                                    {copyright?.source && (
                                        <a
                                            href={copyright.source}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            来源 ↗
                                        </a>
                                    )}
                                </div>
                            )}
                            <div class="article-footer-actions">
                                <span class="article-footer-caption">
                                    分享这篇文章
                                </span>
                                <div class="article-share">
                                    <button
                                        type="button"
                                        class="article-footer-button"
                                        data-copy-link
                                    >
                                        <Icon name="link" size={16} />
                                        复制链接
                                    </button>
                                    <button
                                        type="button"
                                        class="article-footer-button"
                                        data-share
                                    >
                                        <Icon name="share" size={16} />
                                        分享文章
                                    </button>
                                </div>
                            </div>
                        </footer>
                    </article>
                    <div class="article-reading" data-pagefind-ignore>
                        <nav
                            class="post-neighbors"
                            aria-label="相邻文章"
                            data-pagefind-ignore
                        >
                            {previous ? (
                                <a
                                    class="post-neighbor post-neighbor-previous"
                                    href={routeFor('posts', previous.data.slug)}
                                >
                                    <span class="post-neighbor-label">
                                        <Icon name="arrow" size={16} />
                                        上一篇
                                    </span>
                                    <span class="post-neighbor-title">
                                        {previous.data.title}
                                    </span>
                                </a>
                            ) : (
                                <button
                                    type="button"
                                    class="post-neighbor post-neighbor-previous"
                                    disabled
                                >
                                    <span class="post-neighbor-label">
                                        <Icon name="arrow" size={16} />
                                        上一篇
                                    </span>
                                    <span class="post-neighbor-title">
                                        没有更早的文章
                                    </span>
                                </button>
                            )}
                            {next ? (
                                <a
                                    class="post-neighbor post-neighbor-next"
                                    href={routeFor('posts', next.data.slug)}
                                >
                                    <span class="post-neighbor-label">
                                        下一篇
                                        <Icon name="arrow" size={16} />
                                    </span>
                                    <span class="post-neighbor-title">
                                        {next.data.title}
                                    </span>
                                </a>
                            ) : (
                                <button
                                    type="button"
                                    class="post-neighbor post-neighbor-next"
                                    disabled
                                >
                                    <span class="post-neighbor-label">
                                        下一篇
                                        <Icon name="arrow" size={16} />
                                    </span>
                                    <span class="post-neighbor-title">
                                        没有更新的文章
                                    </span>
                                </button>
                            )}
                        </nav>
                    </div>
                    <ArticleRecommendations
                        currentSlug={
                            entry.collection === 'posts'
                                ? entry.data.slug
                                : undefined
                        }
                    />
                    <Comments />
                </div>
                <aside class="article-side" data-pagefind-ignore>
                    <section class="glass-card toc-card" aria-label="阅读导航">
                        <ArticleDirectory
                            toc={toc}
                            column={column}
                            currentSlug={entry.data.slug}
                            variant="sidebar"
                        />
                        <div
                            class="article-directory-footer toc-progress-row"
                            data-directory-progress
                        >
                            <span class="toc-progress-label">阅读进度</span>
                            <div
                                class="reading-progress"
                                role="progressbar"
                                aria-label="文章阅读进度"
                                aria-valuemin="0"
                                aria-valuemax="100"
                                aria-valuenow="0"
                                data-reading-meter
                            >
                                <span data-reading-progress />
                            </div>
                            <small
                                class="toc-progress-value"
                                data-reading-percent
                                aria-hidden="true"
                            >
                                0%
                            </small>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </div>
    {(toc.length > 0 || column) && (
        <dialog
            id="article-toc-dialog"
            class="sky-dialog toc-dialog"
            aria-labelledby="toc-dialog-heading"
            data-pagefind-ignore
        >
            <div class="dialog-heading">
                <div>
                    <p class="toc-dialog-article">{entry.data.title}</p>
                    <h2 id="toc-dialog-heading">
                        {column ? '阅读目录' : '文章目录'}
                    </h2>
                </div>
                <button
                    type="button"
                    class="icon-button"
                    data-close-dialog
                    aria-label="关闭文章目录"
                    autofocus
                >
                    <Icon name="close" size={22} />
                </button>
            </div>
            <div class="toc-dialog-content">
                <ArticleDirectory
                    toc={toc}
                    column={column}
                    currentSlug={entry.data.slug}
                    variant="dialog"
                />
            </div>
            <div class="toc-dialog-footer">
                <span data-directory-progress>
                    阅读进度 <span data-reading-percent>0%</span>
                </span>
                <kbd>Esc</kbd>
                <span>关闭目录</span>
            </div>
        </dialog>
    )}
    <ArticlePostsDialog
        currentSlug={entry.collection === 'posts' ? entry.data.slug : undefined}
    />
</BaseLayout>
