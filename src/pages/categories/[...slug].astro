---
import { getPosts } from '../../lib/content';
import {
    paginateItems,
    publicTaxonomy,
    taxonomyPageSegment,
} from '../../lib/content-model';
import { site } from '../../config/site';
import TaxonomyLayout from '../../layouts/TaxonomyLayout.astro';
export async function getStaticPaths() {
    const posts = await getPosts();
    const categories = publicTaxonomy(posts).categories;
    return categories.flatMap((category) => {
        const entries = posts.filter((post) =>
            post.data.categories.includes(category),
        );
        const pages = paginateItems(entries, site.pageSize);
        const pageSegment = taxonomyPageSegment(
            category,
            categories,
            pages.length,
        );
        return pages.map((items, index) => ({
            params: {
                slug: index
                    ? `${category}/${pageSegment}/${index + 1}`
                    : category,
            },
            props: {
                category,
                posts: items,
                count: entries.length,
                current: index + 1,
                total: pages.length,
                pageSegment,
            },
        }));
    });
}
const { category, posts, count, current, total, pageSegment } = Astro.props;
---

<TaxonomyLayout
    kind="categories"
    title={`文章分类：${category}`}
    posts={posts}
    count={count}
    active={category}
    current={current}
    total={total}
    pageSegment={pageSegment}
/>
