---
import { getPosts } from '../../lib/content';
import { getAuthor } from '../../lib/author';
import { paginateItems, routeFor } from '../../lib/content-model';
import { site } from '../../config';
import ListingLayout from '../../layouts/ListingLayout.astro';
import ContentPreviewList from '../../components/ContentPreviewList.astro';
import Pagination from '../../components/Pagination.astro';
export async function getStaticPaths() {
    const posts = await getPosts();
    const author = getAuthor();
    const entries = posts.filter((post) => post.data.author === author.id);
    const pages = paginateItems(entries, site.pageSize);
    return pages.map((items, index) => ({
        params: {
            slug: index ? `${author.id}/page/${index + 1}` : author.id,
        },
        props: {
            author,
            posts: items,
            count: entries.length,
            current: index + 1,
            total: pages.length,
        },
    }));
}
const { author, posts, count, current, total } = Astro.props;
---

<ListingLayout
    variant="archive"
    title={author.name}
    description={author.bio}
    eyebrow="THE PERSON BEHIND THE WORDS"
    icon="user"
    count={count}
>
    <ContentPreviewList entries={posts} />
    <Pagination
        current={current}
        total={total}
        first={routeFor('authors', author.id)}
        base={`${routeFor('authors', author.id)}page`}
    />
</ListingLayout>
