---
import { getPosts } from '../../lib/content';
import { paginateItems, publicTaxonomy } from '../../lib/content-model';
import { site } from '../../config/site';
import TaxonomyLayout from '../../layouts/TaxonomyLayout.astro';
export async function getStaticPaths() {
    const posts = await getPosts();
    return publicTaxonomy(posts).tags.flatMap((tag) => {
        const entries = posts.filter((post) => post.data.tags.includes(tag));
        const pages = paginateItems(entries, site.pageSize);
        return pages.map((items, index) => ({
            params: { slug: index ? `${tag}/page/${index + 1}` : tag },
            props: {
                tag,
                posts: items,
                count: entries.length,
                current: index + 1,
                total: pages.length,
            },
        }));
    });
}
const { tag, posts, count, current, total } = Astro.props;
---

<TaxonomyLayout
    kind="tags"
    title={`文章标签：${tag}`}
    posts={posts}
    count={count}
    active={tag}
    current={current}
    total={total}
/>
