---
import { getPosts } from '../../lib/content';
import {
    paginateItems,
    publicTaxonomy,
    taxonomyPageSegment,
} from '../../lib/content-model';
import { site } from '../../config/site';
import TaxonomyLayout from '../../layouts/TaxonomyLayout.astro';
export async function getStaticPaths() {
    const posts = await getPosts();
    const tags = publicTaxonomy(posts).tags;
    return tags.flatMap((tag) => {
        const entries = posts.filter((post) => post.data.tags.includes(tag));
        const pages = paginateItems(entries, site.pageSize);
        const pageSegment = taxonomyPageSegment(tag, tags, pages.length);
        return pages.map((items, index) => ({
            params: {
                slug: index ? `${tag}/${pageSegment}/${index + 1}` : tag,
            },
            props: {
                tag,
                posts: items,
                count: entries.length,
                current: index + 1,
                total: pages.length,
                pageSegment,
            },
        }));
    });
}
const { tag, posts, count, current, total, pageSegment } = Astro.props;
---

<TaxonomyLayout
    kind="tags"
    title={`文章标签：${tag}`}
    posts={posts}
    count={count}
    active={tag}
    current={current}
    total={total}
    pageSegment={pageSegment}
/>
