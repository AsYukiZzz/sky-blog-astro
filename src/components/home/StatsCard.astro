---
import type { HomeCardContentProps } from '../../lib/home-cards';
import Icon from '../Icon.astro';
type Props = HomeCardContentProps;
const { headingId } = Astro.props;
import { getPosts, getMoments, taxonomy } from '../../lib/content';
import { publicTaxonomy } from '../../lib/content-model';
import { operatingDays } from '../../lib/site-metrics';
import { site } from '../../config/site';
const [posts, moments] = await Promise.all([getPosts(), getMoments()]);
const { tags } = publicTaxonomy(posts, taxonomy);
const days = operatingDays(site.startedAt, site.timezone);
const stats = [
    {
        href: '/archives/',
        count: posts.length,
        label: '篇文章',
        icon: 'document',
        color: 'primary',
    },
    {
        href: undefined,
        count: days ?? '—',
        label: '运营天数',
        icon: 'calendar',
        color: 'secondary',
        uptime: true,
    },
    {
        href: '/tags/',
        count: tags.length,
        label: '个标签',
        icon: 'tag',
        color: 'accent',
    },
    {
        href: '/moments/',
        count: moments.length,
        label: '篇随笔',
        icon: 'message',
        color: 'info',
    },
];
---

<header class="home-card-header home-card-heading">
    <div>
        <p class="home-card-eyebrow">IN NUMBERS</p>
        <h2 id={headingId}>博客统计</h2>
    </div>
    <span class="home-card-icon" aria-hidden="true">
        <Icon name="grid" size={20} />
    </span>
</header>
<div
    class="home-card-body"
    tabindex="0"
    role="region"
    aria-labelledby={headingId}
>
    <div class="home-stats-grid">
        {stats.map((stat) => {
            const Tile = stat.href ? 'a' : 'div';
            return (
                <Tile
                    href={stat.href}
                    class="home-stat"
                    style={`--stat-color: var(--color-${stat.color})`}
                    title={
                        stat.uptime
                            ? site.startedAt
                                ? `自 ${site.startedAt} 开始运营，当天计为第 1 天`
                                : '建站日期尚未设置'
                            : undefined
                    }
                >
                    <Icon name={stat.icon} size={18} />
                    <strong
                        data-site-uptime={stat.uptime}
                        data-site-started-at={
                            stat.uptime ? site.startedAt : undefined
                        }
                        data-site-timezone={
                            stat.uptime ? site.timezone : undefined
                        }
                    >
                        {stat.count}
                    </strong>
                    <span>{stat.label}</span>
                </Tile>
            );
        })}
    </div>
</div>
