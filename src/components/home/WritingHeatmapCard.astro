---
import type { HomeCardContentProps } from '../../lib/home-cards';
import { getPosts } from '../../lib/content';
import { recentWritingActivity } from '../../lib/writing-activity';
import { formatDate } from '../../lib/format';
import { site } from '../../config/site';
import Icon from '../Icon.astro';

type Props = HomeCardContentProps;
const { headingId } = Astro.props;
const posts = await getPosts();
const activity = recentWritingActivity(posts, site.timezone);
const weeks = activity.days.length / 7;
const months = new Map<number, string>();
for (const day of activity.days) {
    if (
        day.inRange &&
        (day.key === activity.startKey || day.key.endsWith('-01'))
    ) {
        months.set(day.week, `${Number(day.key.slice(5, 7))}月`);
    }
}
---

<header class="home-card-header home-card-heading">
    <div>
        <p class="home-card-eyebrow">LAST 90 DAYS</p>
        <h2 id={headingId}>写作热力图</h2>
    </div>
    <span class="home-card-icon" aria-hidden="true">
        <Icon name="calendar" size={20} />
    </span>
</header>
<div
    class="home-card-body"
    tabindex="0"
    role="region"
    aria-labelledby={headingId}
>
    <div class="home-writing-layout">
        <div class="home-writing-canvas">
            <svg
                class="home-writing-heatmap"
                viewBox={`0 0 ${32 + weeks * 16} 108`}
                role="img"
                aria-label={`${activity.startKey} 至 ${activity.endKey}，共发布 ${activity.totalCount} 篇文章，写作 ${activity.activeDays} 天；颜色越深表示当天发布越多。`}
            >
                {[...months].map(([week, month]) => (
                    <text
                        x={20 + week * 16}
                        y="10"
                        class="home-writing-month"
                        aria-hidden="true"
                    >
                        {month}
                    </text>
                ))}
                {[1, 3, 5].map((day) => (
                    <text
                        x="1"
                        y={18 + day * 12 + 9}
                        class="home-writing-axis"
                        aria-hidden="true"
                    >
                        {['日', '一', '二', '三', '四', '五', '六'][day]}
                    </text>
                ))}
                {activity.days.map((day) => (
                    <rect
                        x={20 + day.week * 16}
                        y={18 + day.day * 12}
                        width="10"
                        height="10"
                        rx="2"
                        class:list={[
                            'heatmap-cell',
                            `heatmap-level-${Math.min(day.count, 3)}`,
                            {
                                'heatmap-outside': !day.inRange,
                                'writing-day-today':
                                    day.key === activity.endKey,
                            },
                        ]}
                        data-writing-day={day.key}
                        data-writing-count={day.count}
                        data-writing-in-range={String(day.inRange)}
                    >
                        <title>{day.key} · {day.inRange ? `${day.count} 篇文章${day.key === activity.endKey ? '（今天）' : ''}` : '统计范围之外'}</title>
                    </rect>
                ))}
            </svg>
            <div class="home-writing-legend" aria-hidden="true">
                <span class="heatmap-legend">
                    少
                    {[0, 1, 2, 3].map((level) => (
                        <i class={`heatmap-cell heatmap-level-${level}`} />
                    ))}
                    多
                </span>
            </div>
        </div>
        <div class="home-writing-summary">
            <div>
                <span>近90天发布</span>
                <strong>
                    {activity.totalCount}
                    <small>篇</small>
                </strong>
            </div>
            <div>
                <span>最近发布</span>
                {activity.latestPublishedAt ? (
                    <time datetime={activity.latestPublishedAt.toISOString()}>
                        {formatDate(activity.latestPublishedAt, true)}
                    </time>
                ) : (
                    <strong>暂无</strong>
                )}
            </div>
        </div>
    </div>
    {activity.totalCount === 0 && (
        <p class="home-writing-empty">最近还没有发布文章，期待下一篇记录。</p>
    )}
</div>
