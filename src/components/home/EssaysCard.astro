---
import type { HomeCardContentProps } from '../../lib/home-cards';
import Icon from '../Icon.astro';
type Props = HomeCardContentProps;
const { headingId, maxPreviewItems } = Astro.props;
import { getMoments } from '../../lib/content';
import HomeMomentPreview from '../HomeMomentPreview.astro';
const moments = await getMoments();
---

<header class="home-card-header home-card-heading">
    <div>
        <p class="home-card-eyebrow">LITTLE ESSAYS</p>
        <h2 id={headingId}>随笔</h2>
    </div>
    <a class="home-card-header-link" href="/moments/" aria-label="全部随笔">
        <Icon name="arrow" size={20} />
    </a>
</header>
<div
    class="home-card-body"
    tabindex="0"
    role="region"
    aria-labelledby={headingId}
>
    <div class="home-moment-grid" data-home-items>
        {moments.slice(0, maxPreviewItems).map((entry) => (
            <HomeMomentPreview entry={entry} />
        ))}
    </div>
    {moments.length === 0 && (
        <p class="home-card-empty">随笔还在酝酿，留下一点今天的想法吧。</p>
    )}
</div>
<footer class="home-card-footer">
    <a class="home-card-more" href="/moments/">
        阅读全部随笔 <Icon name="arrow" size={14} />
    </a>
</footer>
