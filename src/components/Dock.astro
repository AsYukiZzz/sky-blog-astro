---
import Icon from './Icon.astro';
import { theme } from '../config';
interface Props {
    articleDiscovery?: boolean;
}
const { articleDiscovery = false } = Astro.props;
---

{theme.extra.dock && (
    <aside
        class="glass-surface sky-dock"
        aria-label="快捷操作"
        data-pagefind-ignore
    >
        <a class="dock-btn" href="/" aria-label="返回首页">
            <Icon name="home" size={19} />
        </a>
        <button
            class="dock-btn"
            type="button"
            data-open-search
            aria-label="搜索内容"
            aria-haspopup="dialog"
            aria-controls="search-dialog"
        >
            <Icon name="search" size={19} />
        </button>
        <button class="dock-btn" data-theme-toggle aria-label="切换明暗主题">
            <Icon name="sun" size={19} class="light-icon" />
            <Icon name="moon" size={19} class="dark-icon" />
        </button>
        {articleDiscovery && (
            <button
                class="dock-btn dock-discover"
                type="button"
                data-open-article-posts
                aria-haspopup="dialog"
                aria-controls="article-posts-dialog"
            >
                <Icon name="document" size={18} />
                <span>发现文章</span>
            </button>
        )}
        <span class="dock-divider"></span>
        <button class="dock-btn" data-scroll-top aria-label="返回顶部">
            <Icon name="up" size={20} />
        </button>
    </aside>
)}
