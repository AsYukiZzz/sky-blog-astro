---
import type { ResolvedGlobalTheme } from '../lib/global-theme';
import { siteWallpaperScript } from '../lib/site-wallpaper';

interface Props {
    wallpapers: ResolvedGlobalTheme['wallpapers'];
    position: ResolvedGlobalTheme['wallpaperPosition'];
}
const { wallpapers, position } = Astro.props;
const wallpaper = wallpapers[0];
---

<div
    class="site-background"
    data-site-background
    data-wallpaper-id={wallpaper?.id}
    data-wallpapers={JSON.stringify(wallpapers)}
    aria-hidden="true"
    transition:persist="site-background"
    transition:animate="none"
>
    {wallpaper && (
        <img
            src={wallpaper.image}
            alt=""
            data-site-wallpaper
            style={{ 'object-position': position }}
            decoding="async"
            fetchpriority="high"
        />
    )}
</div>
<script is:inline set:html={siteWallpaperScript()} />
