---
import { site } from '../config/site';
import { theme } from '../config/theme';
import { authors, getPosts, getMoments } from '../lib/content';
import { dateKey, publicTaxonomy, routeFor } from '../lib/content-model';
import { formatDate } from '../lib/format';
import { blogStats } from '../lib/site-metrics';
import Icon from './Icon.astro';
const posts = await getPosts();
const moments = await getMoments();
const author =
    authors.find((author) => author.id === site.author) ?? authors[0];
const { categories, tags } = publicTaxonomy(posts);
const stats = blogStats(posts, moments, site);
---

<aside class="sidebar" data-pagefind-ignore>
    {theme.sidebar.map((widget) => (
        <>
            {widget === 'author' && (
                <a
                    href={routeFor('authors', author.id)}
                    class="glass-card author-card"
                >
                    <span class="author-avatar">
                        <img
                            src={author.avatar}
                            width="40"
                            height="40"
                            alt={author.name}
                        />
                        <span class="online-dot"></span>
                    </span>
                    <span class="author-summary">
                        <strong>{author.name}</strong>
                        <small>{author.bio}</small>
                    </span>
                    <Icon name="chevron" size={16} />
                </a>
            )}
            {widget === 'stats' && (
                <section class="glass-card stats-card" aria-label="博客统计">
                    {stats.map((stat) => {
                        const Tile = stat.href ? 'a' : 'div';
                        return (
                            <Tile
                                href={stat.href}
                                class="stats-item"
                                style={`--stat-color: var(--color-${stat.color})`}
                                title={stat.title}
                            >
                                <Icon name={stat.icon} size={20} />
                                <strong
                                    data-site-uptime={stat.uptime}
                                    data-site-started-at={
                                        stat.uptime ? site.startedAt : undefined
                                    }
                                    data-site-timezone={
                                        stat.uptime ? site.timezone : undefined
                                    }
                                >
                                    {stat.count}
                                </strong>
                                <span>{stat.label}</span>
                            </Tile>
                        );
                    })}
                </section>
            )}
            {widget === 'categories' && (
                <section class="glass-card widget">
                    <div class="widget-heading">
                        <span class="widget-icon">
                            <Icon name="folder" size={20} />
                        </span>
                        <div>
                            <h3>文章分类</h3>
                            <p>Categories</p>
                        </div>
                    </div>
                    <div class="category-widget">
                        {categories.map((category) => (
                            <a href={routeFor('categories', category)}>
                                <span>
                                    <Icon name="folder" size={18} />
                                    {category}
                                </span>
                                <small>
                                    {
                                        posts.filter((post) =>
                                            post.data.categories.includes(
                                                category,
                                            ),
                                        ).length
                                    }
                                </small>
                            </a>
                        ))}
                    </div>
                </section>
            )}
            {widget === 'tags' && (
                <section class="glass-card widget">
                    <div class="widget-heading">
                        <span class="widget-icon">
                            <Icon name="tag" size={20} />
                        </span>
                        <div>
                            <h3>标签云</h3>
                            <p>Tags</p>
                        </div>
                    </div>
                    <div class="tag-cloud">
                        {tags.map((tag) => (
                            <a href={routeFor('tags', tag)}>
                                #{tag}
                                <small>
                                    {
                                        posts.filter((post) =>
                                            post.data.tags.includes(tag),
                                        ).length
                                    }
                                </small>
                            </a>
                        ))}
                    </div>
                </section>
            )}
            {widget === 'recent' && (
                <section class="glass-card widget">
                    <div class="widget-heading">
                        <span class="widget-icon">
                            <Icon name="clock" size={20} />
                        </span>
                        <div>
                            <h3>最新文章</h3>
                            <p>Recent Posts</p>
                        </div>
                    </div>
                    <div class="recent-posts">
                        {[...posts]
                            .sort(
                                (a, b) =>
                                    b.data.publishedAt.getTime() -
                                    a.data.publishedAt.getTime(),
                            )
                            .slice(0, 5)
                            .map((post) => (
                                <a href={routeFor('posts', post.data.slug)}>
                                    <time
                                        datetime={post.data.publishedAt.toISOString()}
                                    >
                                        <strong>
                                            {dateKey(
                                                post.data.publishedAt,
                                                site.timezone,
                                            ).slice(-2)}
                                        </strong>
                                        <small>
                                            {new Intl.DateTimeFormat('zh-CN', {
                                                month: 'short',
                                                timeZone: site.timezone,
                                            }).format(post.data.publishedAt)}
                                        </small>
                                    </time>
                                    <span>
                                        <strong>{post.data.title}</strong>
                                        <small>
                                            {formatDate(post.data.publishedAt)}{' '}
                                            · {post.data.description}
                                        </small>
                                    </span>
                                    <Icon name="chevron" size={14} />
                                </a>
                            ))}
                    </div>
                </section>
            )}
        </>
    ))}
</aside>
