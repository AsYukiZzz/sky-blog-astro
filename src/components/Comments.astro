---
import { theme } from '../config';
import Icon from './Icon.astro';
const config = theme.post.comment;
const enabled =
    config.enabled && config.repo && config.repoId && config.categoryId;
---

{enabled && (
    <section class="glass-card comments-section" data-pagefind-ignore>
        <h2>
            <Icon name="message" />
            聊聊你的想法
        </h2>
        <div
            class="giscus"
            data-giscus
            data-repo={config.repo}
            data-repo-id={config.repoId}
            data-category={config.category}
            data-category-id={config.categoryId}
        />
    </section>
)}

<style>
    .comments-section {
        margin-top: 32px;
        padding: var(--article-footer-padding, 24px);
    }
    .comments-section h2 {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 20px;
        font-size: 20px;
        font-weight: 600;
    }
</style>
