---
import { theme } from '../config';
import { getPosts, getPopularPosts } from '../lib/content';
import { routeFor } from '../lib/content-model';
import { formatDate } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
    currentSlug?: string;
}
const { currentSlug } = Astro.props;
const { enabled, maxItems } = theme.post.recommendations;
if (!Number.isSafeInteger(maxItems) || maxItems < 1)
    throw new Error(
        'Invalid theme.post.recommendations.maxItems in src/config.ts: 必须为正整数。',
    );
const [posts, popular] = enabled
    ? await Promise.all([getPosts(), getPopularPosts(maxItems)])
    : [[], []];
const recent = [...posts]
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .slice(0, maxItems);
const panels = [
    { id: 'popular', label: '热门文章', posts: popular },
    { id: 'latest', label: '最新文章', posts: recent },
];
---

{enabled && (
    <section
        class="glass-card article-recommendations"
        aria-label="继续阅读"
        data-article-tabs
        data-pagefind-ignore
    >
        <div class="article-recommendations-heading">
            <div class="article-post-tabs" role="tablist" aria-label="推荐文章">
                {panels.map((panel, index) => (
                    <button
                        type="button"
                        role="tab"
                        id={`article-recommendations-${panel.id}-tab`}
                        data-tab-kind={panel.id}
                        aria-controls={`article-recommendations-${panel.id}-panel`}
                        aria-selected={index === 0}
                        tabindex={index === 0 ? 0 : -1}
                    >
                        {panel.label}
                    </button>
                ))}
            </div>
            <a class="article-widget-more" href="/archives/">
                全部文章 <Icon name="arrow" size={14} />
            </a>
        </div>
        {panels.map((panel, index) => (
            <div
                class="article-posts-panel"
                role="tabpanel"
                id={`article-recommendations-${panel.id}-panel`}
                aria-labelledby={`article-recommendations-${panel.id}-tab`}
                tabindex="0"
                hidden={index !== 0}
            >
                <ol class="article-posts-list">
                    {panel.posts.map((post, rank) => (
                        <li>
                            <a
                                href={routeFor('posts', post.data.slug)}
                                aria-current={
                                    post.data.slug === currentSlug
                                        ? 'page'
                                        : undefined
                                }
                            >
                                <span
                                    class="article-recommendation-index"
                                    aria-hidden="true"
                                >
                                    {String(rank + 1).padStart(2, '0')}
                                </span>
                                <span class="article-post-summary">
                                    <strong>{post.data.title}</strong>
                                    <small>
                                        <time
                                            datetime={post.data.publishedAt.toISOString()}
                                        >
                                            {formatDate(post.data.publishedAt)}
                                        </time>
                                        {post.data.categories[0] && (
                                            <span>
                                                {post.data.categories[0]}
                                            </span>
                                        )}
                                    </small>
                                </span>
                                <Icon name="arrow" size={14} />
                            </a>
                        </li>
                    ))}
                </ol>
                {panel.posts.length === 0 && (
                    <p class="article-widget-empty">
                        暂时没有{panel.label}，先去归档逛逛吧。
                    </p>
                )}
            </div>
        ))}
    </section>
)}
