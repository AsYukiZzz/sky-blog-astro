---
import { theme } from '../config';
import '@fontsource/caveat/400.css';
const hero = theme.home.hero;
---

<section
    class:list={['home-hero', `hero-size-${hero.size}`]}
    aria-label="首页封面"
>
    <div class="home-hero-content">
        <h1 class="home-hero-title">{hero.title}</h1>
        {hero.subtitle && <p class="home-hero-subtitle">{hero.subtitle}</p>}
    </div>
</section>
